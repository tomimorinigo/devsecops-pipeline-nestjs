<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <title>{{title}}</title>
</head>
<body>
  <p><a href="/">Inicio</a></p>
  <form action="/search" method="get">
    <input type="text" name="q" value="{{q}}">
    <button type="submit">Buscar</button>
  </form>
  {{!-- VULN-03: search term rendered without HTML escaping (reflected XSS) --}}
  <h2>Resultados para: {{{q}}}</h2>
  <ul>
    {{#each results}}
      <li><a href="/products/{{id}}">{{name}}</a> — ${{price}}</li>
    {{else}}
      <li>Sin resultados</li>
    {{/each}}
  </ul>
</body>
</html>
